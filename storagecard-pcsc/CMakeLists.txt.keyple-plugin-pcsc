# FetchContent added in CMake 3.11, downloads during the configure step
# FetchContent_MakeAvailable was added in CMake 3.14; simpler usage
INCLUDE(FetchContent)

IF(NOT EXISTS "${CMAKE_BINARY_DIR}/_deps/keyplepluginpcsccpplib-src")

    MESSAGE("-- > Fetching keyple plugin pcsc from storagecard-pcsc example")

    FetchContent_Declare(

        KeyplePluginPcscCppLib

        DOWNLOAD_EXTRACT_TIMESTAMP true
        GIT_REPOSITORY https://github.com/eclipse-keyple/keyple-plugin-pcsc-cpp-lib
        GIT_TAG 2.6.3
    )

ELSE()

    FetchContent_Declare(

        KeyplePluginPcscCppLib

        SOURCE_DIR ${CMAKE_BINARY_DIR}/_deps/keyplepluginpcsccpplib-src
    )

ENDIF()

FetchContent_MakeAvailable(KeyplePluginPcscCppLib)
