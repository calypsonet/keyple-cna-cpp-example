# FetchContent added in CMake 3.11, downloads during the configure step
# FetchContent_MakeAvailable was added in CMake 3.14; simpler usage
INCLUDE(FetchContent)

IF(NOT EXISTS "${CMAKE_BINARY_DIR}/_deps/keyplecardcnastoragecardcpplib-src")

    MESSAGE("-- > Fetching keyple card cna storagecard from storagecard-pcsc example")

    FetchContent_Declare(

        KeypleCardCnaStorageCardCppLib

        DOWNLOAD_EXTRACT_TIMESTAMP true
        GIT_REPOSITORY https://github.com/calypsonet-member/keyple-card-cna-storagecard-cpp-lib
        GIT_TAG feat/develop-2.3.1
    )

ELSE()

    FetchContent_Declare(

        KeypleCardCnaStorageCardCppLib

        SOURCE_DIR ${CMAKE_BINARY_DIR}/_deps/keyplecardcnastoragecardcpplib-src
    )

ENDIF()

FetchContent_MakeAvailable(KeypleCardCnaStorageCardCppLib)
